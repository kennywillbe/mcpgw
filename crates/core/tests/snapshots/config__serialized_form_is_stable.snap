---
source: crates/core/tests/config.rs
expression: config.to_toml_string().unwrap()
---
version = 1

[servers.fs]
enabled = true
type = "stdio"
command = "mcp-server-filesystem"

[servers.github]
enabled = true
tags = [
    "work",
    "vcs",
]
type = "stdio"
command = "npx"
args = [
    "-y",
    "@modelcontextprotocol/server-github",
]

[servers.github.env]
GITHUB_TOKEN = "ghp_test"

[servers.linear]
enabled = false
type = "http"
url = "https://mcp.linear.app/mcp"

[servers.linear.headers]
Authorization = "Bearer test"
