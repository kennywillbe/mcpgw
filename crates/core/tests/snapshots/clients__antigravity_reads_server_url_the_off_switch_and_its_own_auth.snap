            tools: None,
        },
        "legacy": Server {
            enabled: true,
            tags: [],
            calls_per_minute: 0,
            transport: Http {
                url: "https://mcp.legacy.example/mcp",
                headers_command: [],
                headers: {},
                auth: None,
            },
            tools: None,
        },
        "linear": Server {
            enabled: true,
            tags: [],
