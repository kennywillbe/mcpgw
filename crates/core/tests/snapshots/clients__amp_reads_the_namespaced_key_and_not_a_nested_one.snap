---
source: crates/core/tests/clients.rs
expression: read
---
ClientRead {
    servers: {
        "browser": Server {
            enabled: false,
            tags: [],
            transport: Stdio {
                command: "browser-mcp",
                args: [],
                env: {
                    "BROWSER_PROFILE": "work",
                },
            },
            tools: None,
        },
        "linear": Server {
            enabled: true,
            tags: [],
            transport: Http {
                url: "https://mcp.linear.app/sse",
                headers_command: [],
                headers: {},
                auth: None,
            },
            tools: None,
        },
        "playwright": Server {
            enabled: true,
            tags: [],
            transport: Stdio {
                command: "npx",
                args: [
                    "-y",
                    "@playwright/mcp@latest",
                    "--headless",
                ],
                env: {},
            },
            tools: None,
        },
        "sourcegraph": Server {
            enabled: true,
            tags: [],
            transport: Http {
                url: "${SRC_ENDPOINT}/.api/mcp/v1",
                headers_command: [],
                headers: {
                    "Authorization": "token ${SRC_ACCESS_TOKEN}",
                },
                auth: None,
            },
            tools: None,
        },
    },
    problems: [
        Problem {
            server: Some(
                "husk",
            ),
            message: "has neither `command` nor `url`",
        },
    ],
}
