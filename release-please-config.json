{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "component": "mcpgw",
      "include-component-in-tag": false,
      "changelog-path": "/CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "/crates/cli/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/crates/core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/crates/cli/Cargo.toml",
          "jsonpath": "$.dependencies['mcpgw-core'].version"
        },
        {
          "type": "toml",
          "path": "/crates/cli/Cargo.toml",
          "jsonpath": "$['dev-dependencies']['mcpgw-core'].version"
        },
        {
          "type": "toml",
          "path": "/crates/test-server/Cargo.toml",
          "jsonpath": "$['dev-dependencies']['mcpgw-core'].version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name==\"mcpgw\"||@.name.value==\"mcpgw\")].version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name==\"mcpgw-core\"||@.name.value==\"mcpgw-core\")].version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "revert", "section": "Reverts" },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    }
  }
}
